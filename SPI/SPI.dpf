---
# Note: The contents of this file are automatically generated.
# Any changes made by hand may be overwritten.
version: '0.2'
work_dir: .
design_root_dir: .
simulations:
  - name: Sim spi_tb
    options: >-
      -build-all -cs-randc-max 16 +acc+b -code-cov a -waves waves.mxd -top
      work.spi_tb
  - name: Sim spi_single_slave_tb
    options: >-
      -build-all -cs-randc-max 16 +acc+b -code-cov a -waves waves.mxd -top
      work.spi_single_slave_tb
  - name: Sim spi_daisy_chain_tb
    options: >-
      -build-all -cs-randc-max 16 +acc+b -code-cov a -waves waves.mxd -top
      work.spi_daisy_chain_tb
source_files:
  - language: verilog
    path: ../modules/shift_reg.v
    options: '-incdir ../modules/'
  - language: verilog
    path: ../modules/clock_divider.sv
    options: '-incdir ../modules/'
  - language: verilog
    path: testbench.sv
  - language: verilog
    path: spi_top.sv
library_search_paths:
  - $STD_LIBS/ieee93
